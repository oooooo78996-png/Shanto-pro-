name: Build Debug APK
on:
  push:
    branches: [main, master]
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Fix project structure from ZIP if needed
        run: |
          if [ ! -f app/build.gradle.kts ] || [ ! -f app/src/main/AndroidManifest.xml ]; then
            ZIP=$(ls *.zip 2>/dev/null | head -1)
            if [ -z "$ZIP" ]; then echo "::error::ZIP file nai"; exit 1; fi
            rm -rf _x && unzip -q -o "$ZIP" -d _x
            D=$(find _x -name settings.gradle.kts -printf '%h\n' | head -1)
            cp -a "$D"/. .
            rm -rf _x
          fi
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: "8.5"
      - name: Build debug APK
        run: gradle assembleDebug --stacktrace
      - uses: actions/upload-artifact@v4
        with:
          name: ShantoTrader-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
